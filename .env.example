# ---------------------------------------------------------------------
# Inovaweb CAF - variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA commitees .env real.
# ---------------------------------------------------------------------

# entorno
ENV=dev
LOG_LEVEL=INFO
PORT=8001

# base de datos
DATABASE_URL=postgresql+psycopg://caf:CHANGE_ME@postgres:5432/admin_financiera
POSTGRES_USER=caf
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=admin_financiera

# cripto (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))")
AES_KEY=CHANGE_ME_BASE64_32_BYTES
JWT_SECRET=CHANGE_ME_BASE64_32_BYTES
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# dominios publicos
ADMIN_DOMAIN=admin.inovaweb.com.mx
PORTAL_DOMAIN=app.inovaweb.com.mx

# cores Nivel 1 (URLs y API keys admin)
MEDIDOR_BASE_URL=https://medidor.inovaweb.com.mx
MEDIDOR_API_KEY=CHANGE_ME
HUB_BASE_URL=https://hub.inovaweb.com.mx
HUB_API_KEY=CHANGE_ME
MESSAGES_BASE_URL=https://mensajes.inovaweb.com.mx
MESSAGES_API_KEY=CHANGE_ME
FINANZAS_BASE_URL=https://finanzas.inovaweb.com.mx
FINANZAS_API_KEY=CHANGE_ME

# Integracion Scraping (SCRAPING_ADMIN_KEY es REQUERIDA: la app no arranca sin
# ella). SCRAPING_ADMIN_KEY debe ser el Bearer admin de Scraping
# (settings.scraping_bearer_legacy en el repo Scraping).
SCRAPING_BASE_URL=https://scraping.inovaweb.com.mx
SCRAPING_ADMIN_KEY=CHANGE_ME

# Seguridad de webhooks (H4 fail-closed): en ENV=prod es OBLIGATORIA y debe ser
# DISTINTA de HUB_API_KEY, o la app falla al arrancar.
HUB_WEBHOOK_SECRET=CHANGE_ME_DISTINTO_DE_HUB_API_KEY

# Tope de recarga (H5). Opcional; default 50000000 = $500,000 MXN (en centavos).
MAX_RECARGA_CENTS=50000000

# PAC (CFDI 4.0)
PAC_PROVIDER=facturama
PAC_BASE_URL=https://api.facturama.mx
PAC_API_KEY=CHANGE_ME
PAC_API_SECRET=CHANGE_ME
RFC_EMISOR=AAA010101AAA
CER_PATH=/secrets/csd.cer
KEY_PATH=/secrets/csd.key
KEY_PASSWORD=CHANGE_ME

# HTTP
HTTP_TIMEOUT_SEC=10.0
HTTP_RETRIES=3
